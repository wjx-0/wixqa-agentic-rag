# Copy this file to .env and fill in your real key on the server.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional: change this only if you want another DeepSeek judge model.
DEEPSEEK_MODEL=deepseek-v4-flash

# The evaluation scripts also accept LLM_BASE_URL / LLM_API_KEY / LLM_MODEL
# and OPENAI_BASE_URL / OPENAI_API_KEY / OPENAI_MODEL for other providers.

# Optional: DashScope reranker API, used only with --reranker_provider dashscope.
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_RERANK_URL=https://dashscope.aliyuncs.com/compatible-api/v1/reranks
DASHSCOPE_RERANK_MODEL=qwen3-rerank
